POSTGRES_DB=prime
POSTGRES_USER=prime
POSTGRES_PASSWORD=prime-local-password
DATABASE_URL=postgresql+asyncpg://prime:prime-local-password@prime-postgres:5432/prime

JWT_SECRET_KEY=local-dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=prime-api
JWT_AUDIENCE=prime-client
LOG_LEVEL=INFO

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081
# Flutter web picks a random port each run — allow any localhost/127.0.0.1 origin.
CORS_ALLOW_ORIGIN_REGEX=https?://(localhost|127\.0\.0\.1)(:\d+)?
API_DOCS_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=8
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ENABLE_DEV_TOOLS=false
PASSWORD_RESET_EXPOSE_TOKEN=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=10
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
UPLOAD_RATE_LIMIT_ATTEMPTS=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=300

# Optional local push credentials. Leave blank to use durable in-app/SSE only.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.prime.prime
APNS_PRIVATE_KEY=
APNS_USE_SANDBOX=true
PUSH_TIMEOUT_SECONDS=10

EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_EXPOSE_CODE=false

# Yandex — fill in your mailbox and app password (see README).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=your-login@yandex.ru
SMTP_PASSWORD=your-yandex-app-password
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
MAIL_FROM=your-login@yandex.ru
MAIL_FROM_NAME=ПРАЙМ
MAIL_REPLY_TO=your-login@yandex.ru

GROUP_REGION_EXPANSION_MINUTES=5
GROUP_PARTIAL_START_HOURS=12
GROUP_MIN_MEMBERS=3

MATRIX_ENABLED=false
MATRIX_BASE_URL=http://matrix-synapse:8008
MATRIX_PUBLIC_BASE_URL=http://localhost:8008
MATRIX_SERVER_NAME=localhost
MATRIX_SHARED_SECRET=change-me-before-enabling-matrix
MATRIX_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key-for-local-matrix
MATRIX_PASSWORD_SECRET=generate-a-separate-local-matrix-password-secret
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.132.0
