POSTGRES_DB=prime
POSTGRES_USER=prime
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://prime:change-me@prime-postgres:5432/prime
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ISSUER=prime-api
JWT_AUDIENCE=prime-client
LOG_LEVEL=INFO
LAST_SEEN_WRITE_INTERVAL_SECONDS=60
CORS_ALLOWED_ORIGINS=https://app.inpr1me.ru,https://inpr1me.ru,https://www.inpr1me.ru
API_DOCS_ENABLED=false
AUTH_LOGIN_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT_ATTEMPTS=8
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
ENABLE_DEV_TOOLS=false
PASSWORD_RESET_EXPOSE_TOKEN=false
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_ATTEMPTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
UPLOAD_RATE_LIMIT_ATTEMPTS=30
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=300

# Signup email confirmation. Keep EXPOSE_CODE false everywhere except CI seeds.
EMAIL_VERIFICATION_CODE_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_EXPOSE_CODE=false

# --- Yandex SMTP (recommended for inpr1me.ru) ---
# 1) Connect domain in Yandex 360: https://admin.yandex.ru → Почта → Домены
# 2) Create mailbox e.g. noreply@inpr1me.ru (or use existing)
# 3) Enable 2FA on the account → create app password:
#    https://id.yandex.ru/security/app-passwords → «Почта»
# 4) MAIL_FROM must match SMTP_USERNAME (or a verified alias on that domain)
# 5) DNS for deliverability — see README section «Yandex и антиспам»
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=noreply@inpr1me.ru
SMTP_PASSWORD=your-yandex-app-password
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
SMTP_TIMEOUT_SECONDS=15
MAIL_FROM=noreply@inpr1me.ru
MAIL_FROM_NAME=ПРАЙМ
MAIL_REPLY_TO=support@inpr1me.ru

GROUP_REGION_EXPANSION_MINUTES=5
GROUP_PARTIAL_START_HOURS=12
GROUP_MIN_MEMBERS=3
MATCH_CANDIDATE_SCAN_LIMIT=120
MATRIX_ENABLED=false
# Internal Synapse address. It does not change when the public domain changes.
MATRIX_BASE_URL=http://matrix-synapse:8008
# Public Matrix URL. A paid domain can be placed here later without code changes.
MATRIX_PUBLIC_BASE_URL=https://matrix.example.invalid
MATRIX_SERVER_NAME=matrix.example.invalid
MATRIX_SHARED_SECRET=change-me-to-a-long-random-matrix-secret
MATRIX_TOKEN_ENCRYPTION_KEY=generate-a-fernet-key-for-matrix-token-encryption
MATRIX_PASSWORD_SECRET=generate-a-separate-random-matrix-password-secret
SYNAPSE_IMAGE=matrixdotorg/synapse:v1.132.0
